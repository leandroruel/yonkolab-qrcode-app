{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yonkolab-qrcode",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "routes": [
    { "pattern": "qr.yonkolab.xyz/qrcode*", "zone_name": "yonkolab.xyz" },
    { "pattern": "qr.yonkolab.xyz/q/*", "zone_name": "yonkolab.xyz" },
    { "pattern": "qr.yonkolab.xyz/favicon.ico", "zone_name": "yonkolab.xyz" }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "base_path": "/qrcode/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/qrcode/api/*", "/q/*", "/favicon.ico"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yonkolab-qrcode",
      "database_id": "2fab08ad-1331-42bb-934b-30ee08b847da"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "SCANS" }],
  "observability": { "enabled": true }
}